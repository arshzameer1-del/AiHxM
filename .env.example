# Phase 1 local development defaults — matches docker-compose.yml.
# For a real environment, replace DATABASE_URL/APP_DATABASE_URL with the
# Supabase project's connection strings (Settings > Database > Connection
# string) and set the Supabase project URL / anon / service role keys
# below. Provisioning that live Supabase project is the one step that
# needs the account owner's own credentials — it hasn't been created yet.

# Owner/migration connection (apps/api/src/database/migrate.ts). Creates
# the app_role login, schemas, tables, and RLS policies. Never used by the
# running API — see APP_DATABASE_URL below for that.
DATABASE_URL="postgresql://boostfactor:boostfactor_dev@localhost:5432/boostfactor?schema=public"

# Request-scoped connection the API actually runs queries through
# (apps/api/src/database/database.module.ts). This is the role RLS
# policies in migrations/0001_platform_admin_core.sql are written for —
# deliberately not the owner role above.
APP_DATABASE_URL="postgresql://app_role:app_role_dev_password@localhost:5432/boostfactor?schema=public"

REDIS_URL="redis://localhost:6379"
PORT=4000

# Phase 3 real auth (see apps/api/src/auth). Signs/verifies session JWTs
# and the short-lived MFA tickets that carry state between password
# verification and MFA verification/enrollment. Change in any shared
# environment; there is no default worth keeping past local dev.
JWT_SECRET="change-me-dev-only-jwt-secret"

# 32+ char passphrase used (via scrypt) to derive the AES-256-GCM key that
# encrypts TOTP secrets at rest (apps/api/src/auth/mfa-secret-crypto.ts).
# Losing/rotating this invalidates every enrolled account's MFA — they'd
# need to re-enroll. Change in any shared environment.
MFA_ENCRYPTION_KEY="change-me-dev-only-mfa-encryption-key-32chars-min"

# One-time bootstrap for the very first Platform Admin account
# (apps/api/src/database/seed.ts — `npm run seed --workspace=@boostfactor/api`).
# Safe to leave set after the first run: the script is idempotent and does
# nothing once this email already has a platform_admins row.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL="admin@boostfactor.dev"
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD="change-me-dev-only-bootstrap-pw"
PLATFORM_ADMIN_BOOTSTRAP_NAME="Platform Admin"

# --- Supabase (fill in once the project exists) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
