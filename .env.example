# Phase 1 local development defaults — matches docker-compose.yml.
# For a real environment, replace DATABASE_URL with the Supabase project's
# connection string (Settings > Database > Connection string, "Session"
# pooler for the API) and set the Supabase project URL / anon / service
# role keys below. Provisioning that live Supabase project is the one step
# in Phase 1 that needs the account owner's own credentials — it hasn't
# been created yet.

DATABASE_URL="postgresql://boostfactor:boostfactor_dev@localhost:5432/boostfactor?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000

# --- Supabase (fill in once the project exists) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
