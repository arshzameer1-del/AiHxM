# tsconfig.node.json's composite build output for vite.config.ts (see that
# file's own comment) — was previously un-set and emitted vite.config.js/
# .d.ts checked into git right beside vite.config.ts, which is what made a
# real edit to vite.config.ts silently do nothing (Vite prefers a
# same-directory .js config over .ts).
apps/web/.tsbuild-node

# Redis snapshot files (redis-server drops dump.rdb in whatever folder it was started from)
*.rdb

# Personal, local-only helper scripts. They hold personal emails and TOTP/credential lookups, so they stay
# on the developer machine. New ones go in apps/api/scripts/local/.
apps/api/scripts/local/
apps/api/src/database/get-totp-*.ts
apps/api/src/database/seed-kumail-test.ts
apps/api/src/database/check-e2e-test-data.ts

