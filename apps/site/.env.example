# Build-time settings for apps/site. Nothing here is secret: it all ends up in the public pages.
MARKETING_SITE_URL="https://aihxm.com"
MARKETING_APP_URL="https://app.aihxm.com"
MARKETING_API_URL="https://api.aihxm.com"
# Leave empty until real. The site then shows no address / number at all.
# MARKETING_CONTACT_EMAIL="..."
# MARKETING_CONTACT_PHONE="..."
# MARKETING_WHATSAPP="923001234567"   (digits only, an approved number; the WhatsApp button appears only when set)
# "true" only for the real launch. Anything else keeps every page noindex.
MARKETING_INDEXABLE="false"
MARKETING_PRIVACY_REVIEWED="false"
MARKETING_TERMS_REVIEWED="false"
