# Build-time settings for the marketing site (apps/marketing). Set these in the Cloudflare Pages project's
# environment variables. Nothing here is a secret: all of it ends up in the public pages.

# Public address of the marketing site (canonical links, sitemap, social tags).
MARKETING_SITE_URL="https://aihxm.com"
# Where the product lives; the "Sign in" buttons and the old-link redirects point here.
MARKETING_APP_URL="https://app.aihxm.com"
# The API that stores demo requests (POST /public/demo-requests). Its CORS_ORIGIN must include the site address.
MARKETING_API_URL="https://api.aihxm.com"

# Real contact details. Leave empty until they exist: the site then shows no address at all, never a made-up one.
# MARKETING_CONTACT_EMAIL="..."
# MARKETING_CONTACT_PHONE="..."

# Search engines: "true" only for the real launch. Anything else keeps every page noindex and robots.txt closed.
MARKETING_INDEXABLE="false"
# "true" once a lawyer has reviewed the privacy notice (removes the "draft" banner on /privacy/).
MARKETING_PRIVACY_REVIEWED="false"
