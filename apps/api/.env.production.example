# Template for a real environment (Supabase + Render). Copy the values
# this file names into Render's own "Environment" tab for the API
# service — never commit a filled-in copy of this file, and never paste
# real secrets into chat or a shared doc.
#
# Where each Supabase value comes from: Supabase dashboard > your project
# > Project Settings.

# --- Database (Project Settings > Database > Connection string) ---
#
# Supabase gives you two connection strings worth knowing apart:
#  - "Connection pooling" (port 6543, via PgBouncer) — best for the
#    request-scoped APP_DATABASE_URL below, since the API opens many
#    short-lived connections under normal traffic.
#  - "Direct connection" (port 5432) — required for DATABASE_URL below,
#    since the migration runner issues `CREATE ROLE`/DDL that PgBouncer's
#    transaction-pooling mode does not reliably support.
#
# Both connect as Supabase's own `postgres` superuser by default — that's
# correct for DATABASE_URL (the migration/owner role), but APP_DATABASE_URL
# must instead use `app_role` (see APP_ROLE_PASSWORD below), the same
# RLS-scoped role every migration's policies are written for. Swap the
# username/password in the pooled connection string's host from
# `postgres`/<your DB password> to `app_role`/<APP_ROLE_PASSWORD's value>.

# Owner/migration connection — run once via `npm run migrate`, from your
# own machine or a one-off Render job, never by the running API itself.
DATABASE_URL="postgresql://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Request-scoped connection the running API actually queries through.
# Same host, but as `app_role` — set APP_ROLE_PASSWORD below to a real
# generated secret, run `npm run migrate` once with it set so the
# migration runner rotates `app_role`'s password to match (see
# apps/api/src/database/migrate.ts), then use that same password here.
APP_DATABASE_URL="postgresql://app_role:<APP_ROLE_PASSWORD-value>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"

# A real, generated secret (e.g. `openssl rand -base64 24`) — never the
# migration's built-in dev default (`app_role_dev_password`). Set this,
# run `npm run migrate` once against DATABASE_URL above, then use the same
# value in APP_DATABASE_URL's password.
APP_ROLE_PASSWORD="<generate-a-real-secret>"

# Supabase's Postgres requires TLS; this codebase auto-detects a
# `*.supabase.co`/`*.supabase.com` host and enables it automatically
# (apps/api/src/database/db-connection.util.ts). Only set this explicitly
# if you're pointing at some other managed Postgres host that also needs
# TLS but isn't Supabase.
# DATABASE_SSL="true"

REDIS_URL=""
# Leave unset if you don't have a Redis instance yet — check
# apps/api/src/cache before assuming this is required; it may already
# degrade gracefully without one.

PORT=4000

# Real, rotated production secrets — generate with e.g. `openssl rand -hex
# 32`. Never reuse the local dev placeholder values.
JWT_SECRET="<generate-a-real-secret>"
MFA_ENCRYPTION_KEY="<generate-a-real-32-plus-char-secret>"

# SEC-02 field-level encryption (CNIC, DOB, bank/IBAN, salary, integration
# secrets). Generate with `openssl rand -base64 32`. BACK THIS UP outside the
# hosting provider: if it is lost the encrypted columns cannot be recovered.
# To rotate: put the new key here and move the old one to
# FIELD_ENCRYPTION_KEY_PREVIOUS, then run the re-wrap job.
FIELD_ENCRYPTION_KEY="<generate-a-real-32-byte-secret>"
# FIELD_ENCRYPTION_KEY_PREVIOUS=""

# Hire drafts untouched for this many days have their sensitive card answers
# scrubbed (SEC-04). Default 30.
# HIRE_DRAFT_RETENTION_DAYS=30

# SEC-05: the dummy/demo fixture routes are off when NODE_ENV=production.
# Only set this on a staging/demo deployment.
# ENABLE_DEMO_FIXTURES=true

# Encrypts tenant data exports at rest by default (Phase 2 gap-fill item #6).
EXPORT_ENCRYPTION_KEY="<generate-a-real-32-plus-char-secret>"

# First Platform Admin account, created once by `npm run seed`.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL="<your-real-admin-email>"
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD="<a-real-strong-password>"
PLATFORM_ADMIN_BOOTSTRAP_NAME="Platform Admin"

# --- Supabase (Project Settings > API) ---
# Auth is still self-hosted in this codebase (DECISIONS.md #3), but file
# storage now uses these: with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# both set, FileStorageModule switches to SupabaseFileStorageService
# instead of writing to the API's own local disk — required in production,
# since Render's disk is wiped on every deploy/restart (see that service's
# doc comment; this was the cause of uploaded logos/backgrounds silently
# disappearing). Leave both blank only for local dev/tests, where the
# local-disk fallback is fine.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Create this bucket once in the Supabase dashboard (Storage > New bucket)
# — PRIVATE, not public, since the API is the only thing that ever reads
# it directly. Defaults to "aihxm-files" if left unset; only set this if
# you named the bucket something else.
SUPABASE_STORAGE_BUCKET=""

# The real frontend origin(s) this API should accept requests from —
# your Netlify site URL(s), comma-separated, no trailing slash.
CORS_ORIGIN="https://<your-site>.netlify.app"

# Used by AuthService.requestPasswordReset() to build the reset link sent
# in the real email (see MailerService), and by SsoService to send an SSO
# login back to the right place when it finishes — your Netlify site's
# real URL.
APP_BASE_URL="https://<your-site>.netlify.app"

# --- Single Sign-On (Phase 3 item #1, OIDC) ---
# No new REQUIRED variable here: on Render, RENDER_EXTERNAL_URL is set
# automatically for every deployed service to that service's own public
# URL (e.g. https://aihxm-api.onrender.com) — SsoService uses it to build
# the one "Redirect URI" value you register with a tenant's identity
# provider (https://aihxm-api.onrender.com/auth/sso/callback). Leave
# API_BASE_URL unset on Render.
#
# Only set this explicitly if you're running the API somewhere OTHER than
# Render (so RENDER_EXTERNAL_URL is never set), or in front of a custom
# domain/proxy where the API's real public URL differs from what Render
# reports.
# API_BASE_URL="https://<your-api-host>"

# --- Single Sign-On (Phase 3 item #1, slice 2: SAML 2.0) ---
# No new REQUIRED variable here either. When a tenant asks for SAML
# instead of OIDC, their IdP admin needs exactly two fixed values from
# you (the same "one static value for every tenant" shape as the OIDC
# redirect URI above):
#   - Entity ID / Audience URI: urn:aihxm:sp
#   - ACS URL (Assertion Consumer Service): your API's public URL +
#     "/auth/sso/saml/acs" (e.g. https://aihxm-api.onrender.com/auth/sso/saml/acs)
# Only set this if you need this SP to present a DIFFERENT Entity ID than
# the default above — e.g. running a second AIHXM environment (staging)
# against the same tenant's IdP, where it needs to look like a distinct SP.
# SAML_SP_ENTITY_ID="urn:aihxm:sp"

# --- Real transactional email (optional for a first test deploy) ---
# Leave all four unset and the API falls back to logging emails instead
# of sending them (MailerService.isConfigured()) — fine for testing
# functionality that doesn't depend on a real inbox. Fill in once you
# have a real SMTP provider (SendGrid, Mailgun, AWS SES, or Gmail SMTP
# with an app password).
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# --- Added by the 2026-10 hardening pass ---
# TRUST_PROXY_HOPS=1          # 1 = Render only; 2 = Cloudflare proxying in front of Render (client IPs, IP allow-lists)
# LOG_REQUESTS=on             # one JSON line per request with the correlation id (on by default in production)
# REDIS_URL=redis://...       # shared cache + shared rate-limit counters (required with more than one instance)
# EXPORT_ENCRYPTION_KEY=...   # encrypts tenant data exports
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM / SMTP_SECURE   # password-reset + notification e-mail
# The API refuses to start in production without JWT_SECRET (>= 32 chars), APP_DATABASE_URL, MFA_ENCRYPTION_KEY,
# FIELD_ENCRYPTION_KEY and CORS_ORIGIN.
