# Template for a real environment (Supabase + Render). Copy the values
# this file names into Render's own "Environment" tab for the API
# service — never commit a filled-in copy of this file, and never paste
# real secrets into chat or a shared doc.
#
# Where each Supabase value comes from: Supabase dashboard > your project
# > Project Settings.

# --- Database (Project Settings > Database > Connection string) ---
#
# Supabase gives you two connection strings worth knowing apart:
#  - "Connection pooling" (port 6543, via PgBouncer) — best for the
#    request-scoped APP_DATABASE_URL below, since the API opens many
#    short-lived connections under normal traffic.
#  - "Direct connection" (port 5432) — required for DATABASE_URL below,
#    since the migration runner issues `CREATE ROLE`/DDL that PgBouncer's
#    transaction-pooling mode does not reliably support.
#
# Both connect as Supabase's own `postgres` superuser by default — that's
# correct for DATABASE_URL (the migration/owner role), but APP_DATABASE_URL
# must instead use `app_role` (see APP_ROLE_PASSWORD below), the same
# RLS-scoped role every migration's policies are written for. Swap the
# username/password in the pooled connection string's host from
# `postgres`/<your DB password> to `app_role`/<APP_ROLE_PASSWORD's value>.

# Owner/migration connection — run once via `npm run migrate`, from your
# own machine or a one-off Render job, never by the running API itself.
DATABASE_URL="postgresql://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Request-scoped connection the running API actually queries through.
# Same host, but as `app_role` — set APP_ROLE_PASSWORD below to a real
# generated secret, run `npm run migrate` once with it set so the
# migration runner rotates `app_role`'s password to match (see
# apps/api/src/database/migrate.ts), then use that same password here.
APP_DATABASE_URL="postgresql://app_role:<APP_ROLE_PASSWORD-value>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"

# A real, generated secret (e.g. `openssl rand -base64 24`) — never the
# migration's built-in dev default (`app_role_dev_password`). Set this,
# run `npm run migrate` once against DATABASE_URL above, then use the same
# value in APP_DATABASE_URL's password.
APP_ROLE_PASSWORD="<generate-a-real-secret>"

# Supabase's Postgres requires TLS; this codebase auto-detects a
# `*.supabase.co`/`*.supabase.com` host and enables it automatically
# (apps/api/src/database/db-connection.util.ts). Only set this explicitly
# if you're pointing at some other managed Postgres host that also needs
# TLS but isn't Supabase.
# DATABASE_SSL="true"

REDIS_URL=""
# Leave unset if you don't have a Redis instance yet — check
# apps/api/src/cache before assuming this is required; it may already
# degrade gracefully without one.

PORT=4000

# Real, rotated production secrets — generate with e.g. `openssl rand -hex
# 32`. Never reuse the local dev placeholder values.
JWT_SECRET="<generate-a-real-secret>"
MFA_ENCRYPTION_KEY="<generate-a-real-32-plus-char-secret>"

# First Platform Admin account, created once by `npm run seed`.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL="<your-real-admin-email>"
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD="<a-real-strong-password>"
PLATFORM_ADMIN_BOOTSTRAP_NAME="Platform Admin"

# --- Supabase (Project Settings > API) ---
# Not required for anything the API currently does at runtime (auth and
# storage are self-hosted in this codebase, per DECISIONS.md #3) — fill
# these in only once/if a feature is built that calls Supabase's own API
# directly. Safe to leave blank for now.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# The real frontend origin(s) this API should accept requests from —
# your Netlify site URL(s), comma-separated, no trailing slash.
CORS_ORIGIN="https://<your-site>.netlify.app"

# Used by AuthService.requestPasswordReset() to build the reset link sent
# in the real email (see MailerService) — your Netlify site's real URL.
APP_BASE_URL="https://<your-site>.netlify.app"

# --- Real transactional email (optional for a first test deploy) ---
# Leave all four unset and the API falls back to logging emails instead
# of sending them (MailerService.isConfigured()) — fine for testing
# functionality that doesn't depend on a real inbox. Fill in once you
# have a real SMTP provider (SendGrid, Mailgun, AWS SES, or Gmail SMTP
# with an app password).
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
