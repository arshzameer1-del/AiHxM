// BoostFactor — Prisma schema
//
// Phase 1 scope only: this file's job is to prove `prisma generate` /
// `prisma migrate` work end to end against a real Postgres instance
// (local Docker now, the real Supabase project once it's provisioned).
// It intentionally has no domain tables yet.
//
// Phase 2 adds: companies, company_config, company_admins,
// platform_admins, audit_log.
// Phase 4 adds: permissions, roles, assignment_rules.
// Phase 5 adds: module_catalog, package_tier, tenant_module_entitlement.
// Phase 7 adds: employees (with employee_number — see plan doc Section 5).
//
// Every tenant-owned table introduced from Phase 2 onward MUST carry a
// company_id column and a matching Row Level Security policy — enforced
// by CI, not just convention (plan doc Section 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder model so the schema is valid and migratable from day one.
/// Delete this once the first real Phase 2 model lands.
model SchemaBaseline {
  id        String   @id @default(uuid())
  note      String   @default("BoostFactor Phase 1 baseline — replaced by real domain models starting Phase 2")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("_schema_baseline")
}
